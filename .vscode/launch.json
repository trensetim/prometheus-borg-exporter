{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Python Debugger: Current File",
			"type": "debugpy",
			"request": "launch",
			"program": "src/main/python/main.py",
			"console": "integratedTerminal",
			"env": {
				"BORG_REPOSITORY_PATH": ".local/repo",
                "BORG_REPOSITORY_PASSPHRASE_FILE": ".local/passphrase",
                "PROMETHEUS_EXPORTER_SCAN_INTERVAL_SECONDS": "5",
                "PROMETHEUS_EXPORTER_CONFIG_FILE": "src/main/resources/config.json"
			}
		}
	]
}
