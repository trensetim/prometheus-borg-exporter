{
    "logging": {
        "debug": "${PROMETHEUS_EXPORTER_DEBUG}"
    },
    "http": {
        "port": "${PROMETHEUS_EXPORTER_HTTP_PORT}"
    },
    "scan": {
        "interval_seconds": "${PROMETHEUS_EXPORTER_SCAN_INTERVAL_SECONDS}",
        "initial_failure_allowed": "${PROMETHEUS_EXPORTER_ALLOW_INITIAL_SCAN_FAILURE}",
        "exit_on_failure": "${PROMETHEUS_EXPORTER_EXIT_ON_FAILURE}"
    },
    "repositories": {
        "${BORG_REPOSITORY_NAME}": {
            "path": "${BORG_REPOSITORY_PATH}",
            "bypass_lock": "${BORG_REPOSITORY_BYPASS_LOCK}",
            "locking": "${BORG_REPOSITORY_LOCKING}",
            "locking_timeout_seconds": "${BORG_REPOSITORY_LOCKING_TIMEOUT_SECONDS}",
            "passphrase_file": "${BORG_REPOSITORY_PASSPHRASE_FILE}",
            "flock_enabled": "${BORG_REPOSITORY_FLOCK_ENABLED}",
            "flock_file": "${BORG_REPOSITORY_FLOCK_FILE}",
            "flock_timeout_seconds": "${BORG_REPOSITORY_FLOCK_TIMEOUT_SECONDS}",
            "flock_backoffs": "${BORG_REPOSITORY_FLOCK_BACKOFFS}"
        }
    }
}
